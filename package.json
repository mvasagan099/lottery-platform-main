    "@fastify/redis": "^9.0.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.3",
    "@prisma/client": "^5.14.0",
    "argon2": "^0.41.1",
    "bull": "^4.16.3",
    "cron": "^3.1.7",
    "cron-parser": "^5.6.2",
    "csv-writer": "^1.6.0",
